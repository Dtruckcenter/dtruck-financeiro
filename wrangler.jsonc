{
  "$schema": "node_modules/wrangler/config-schema.json",
  // O nome precisa ser igual ao nome do Worker criado no painel da Cloudflare.
  "name": "dtruck-financeiro",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // As telas (public/) são embutidas no Worker no momento do deploy.
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.txt"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtruck-financeiro",
      // Copie o "Database ID" em Storage & Databases > D1 > dtruck-financeiro.
      "database_id": "c5ac57f1-78e3-4ae0-8a2d-fcfff3490ace"
    }
  ],
  // Mantém as variáveis (ADMIN_EMAILS, ACCESS_AUD...) configuradas no painel a cada deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
